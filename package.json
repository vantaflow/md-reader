{
  "name": "md-to-pdf-app",
  "version": "1.8.0",
  "description": "Markdown editor with PDF export for macOS and Windows",
  "main": "main.js",
  "scripts": {
    "bundle": "esbuild renderer/editor-src.js --bundle --outfile=renderer/editor-bundle.js --format=iife --minify && esbuild renderer/markdown-src.js --bundle --outfile=renderer/markdown-bundle.js --format=iife --minify && esbuild renderer/docx-src.js --bundle --outfile=renderer/docx-bundle.js --format=iife --minify && esbuild renderer/jszip-src.js --bundle --outfile=renderer/jszip-bundle.js --format=iife --minify",
    "start": "npm run bundle && electron .",
    "build": "npm run bundle && electron-builder",
    "build:mac": "npm run bundle && electron-builder --mac",
    "build:win": "npm run bundle && electron-builder --win",
    "test": "npm run bundle && node --test test/markdown.test.js test/pdf.test.js test/packaging.test.js test/settings.test.js test/format.test.js test/menu.test.js test/images.test.js test/tableau.test.js test/reformat.test.js test/ecriture.test.js test/modeles-snippets.test.js test/plan.test.js test/navigation.test.js test/remplacement.test.js test/dossier.test.js test/remplacement-dossier.test.js test/export-partage.test.js test/epub-diaporama.test.js && electron test/smoke.js && electron test/smoke-lot1.js && electron test/smoke-docx.js && electron test/smoke-focus.js && electron test/smoke-images.js && electron test/smoke-lot2a.js && electron test/smoke-lot2b.js && electron test/smoke-lot2c.js"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@electron/packager": "^20.0.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.28.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.41.1",
    "chokidar": "^3.6.0",
    "docx": "^9.14.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "jszip": "^3.10.2",
    "katex": "^0.16.45",
    "marked": "^14.1.0",
    "marked-alert": "^2.1.2",
    "marked-directive": "^1.0.7",
    "marked-footnote": "^1.4.0",
    "marked-highlight": "^2.2.4",
    "marked-katex-extension": "^5.1.8",
    "mermaid": "^11.14.0"
  },
  "build": {
    "appId": "com.lilou.mdtopdf",
    "productName": "MD Reader",
    "files": [
      "main.js",
      "preload.js",
      "pdf.js",
      "menu.js",
      "images.js",
      "contexte.js",
      "donnees.js",
      "presse-papiers.js",
      "remplacement.js",
      "renderer/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown Document",
        "description": "Markdown Document",
        "role": "Editor"
      },
      {
        "ext": "markdown",
        "name": "Markdown Document",
        "description": "Markdown Document",
        "role": "Editor"
      },
      {
        "ext": "mdown",
        "name": "Markdown Document",
        "description": "Markdown Document",
        "role": "Editor"
      },
      {
        "ext": "mkd",
        "name": "Markdown Document",
        "description": "Markdown Document",
        "role": "Editor"
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Markdown File",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Default",
            "LSItemContentTypes": [
              "net.daringfireball.markdown",
              "public.plain-text"
            ],
            "CFBundleTypeExtensions": [
              "md",
              "markdown",
              "txt"
            ]
          }
        ]
      }
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MD Reader"
    }
  }
}
